#!/usr/bin/env bash
#
# Refuse to push app changes to main without a version bump.
#
# Pushing main triggers the Cloudflare Pages deploy, and sw.js serves cache-first.
# If CACHE_VERSION is unchanged, already-pinned home-screen installs keep serving
# the old build -- the change deploys but never reaches the devices that matter.
# This hook makes that failure impossible to reach by accident.
#
# Enabled via: git config core.hooksPath .githooks
# Bypass (rare, e.g. README-only fix already covered): git push --no-verify

set -uo pipefail

ZERO=0000000000000000000000000000000000000000
SEMVER='[0-9]+\.[0-9]+\.[0-9]+'

# Files whose contents reach a pinned install. README/LICENSE/workflow changes
# don't need a bump; these do.
WATCHED=(index.html sw.js manifest.webmanifest icons)

version_at() {
  git show "$1:index.html" 2>/dev/null |
    sed -nE "s/.*id=\"appVersion\"[^>]*>v(${SEMVER})<.*/\1/p" | head -1
}

sw_version_at() {
  git show "$1:sw.js" 2>/dev/null |
    sed -nE "s/^const CACHE_VERSION = 'told-v(${SEMVER})';.*/\1/p" | head -1
}

status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  # Only guard main -- that's the branch the deploy workflow acts on.
  [ "$remote_ref" = "refs/heads/main" ] || continue
  # Branch deletion.
  [ "$local_sha" = "$ZERO" ] && continue

  local_v=$(version_at "$local_sha")
  local_sw=$(sw_version_at "$local_sha")

  if [ -z "$local_v" ] || [ -z "$local_sw" ]; then
    echo "pre-push: could not read the version from index.html and sw.js at $local_sha" >&2
    status=1
    continue
  fi

  if [ "$local_v" != "$local_sw" ]; then
    echo "pre-push: version mismatch in the commit being pushed --" >&2
    echo "  index.html = v$local_v" >&2
    echo "  sw.js      = told-v$local_sw" >&2
    echo "  Run scripts/bump-version.sh to resync, then commit the result." >&2
    status=1
    continue
  fi

  # First push of the branch: nothing to compare against.
  [ "$remote_sha" = "$ZERO" ] && continue

  changed=$(git diff --name-only "$remote_sha" "$local_sha" -- "${WATCHED[@]}" 2>/dev/null)
  [ -z "$changed" ] && continue

  remote_v=$(version_at "$remote_sha")
  if [ "$local_v" = "$remote_v" ]; then
    echo "pre-push: app files changed but the version is still v$local_v" >&2
    echo "" >&2
    echo "  changed:" >&2
    printf '    %s\n' $changed >&2
    echo "" >&2
    echo "  Pinned installs cache-first on CACHE_VERSION, so this deploy would not" >&2
    echo "  reach them. Bump first:" >&2
    echo "" >&2
    echo "    scripts/bump-version.sh          # or minor / major / X.Y.Z" >&2
    echo "    git commit -m '...' -- index.html sw.js" >&2
    echo "" >&2
    status=1
  fi
done

exit $status
